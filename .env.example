# Copy to .env and fill in. Never commit .env.

# Required
# Discord bot token
bot_token=
# Discord application/client ID
clientId=
# Discord guild ID — used by dep-cmd to register commands
guildId=

# Optional
# "true" to enable facepalm responses
facepalmEnabled=
# smart episode matching in /findepisode; falls back to fuzzy match if unset
ANTHROPIC_API_KEY=
# max /findepisode uses per user per 10 min (default: 5)
FINDEPISODE_RATE_LIMIT_MAX=
# SQLite file path; default data/ubot.db relative to cwd (/app/data/ubot.db on the container volume)
DB_PATH=
# Uptime Kuma push monitor URL (no query string) — heartbeat every 60s
KUMA_PUSH_URL=
# channel ID where /featurerequest posts land; unset = submissions fail gracefully
FEATURE_REQUEST_CHANNEL_ID=
# user ID mentioned on each /featurerequest post (optional)
FEATURE_REQUEST_MAINTAINER_ID=
