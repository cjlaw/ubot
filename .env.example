# Copy to .env and fill in. Never commit .env.

# Required
bot_token=                    # Discord bot token
clientId=                     # Discord application/client ID
guildId=                      # Discord guild ID — used by dep-cmd to register commands

# Optional
facepalmEnabled=              # "true" to enable facepalm responses
ANTHROPIC_API_KEY=            # smart episode matching in /findepisode; falls back to fuzzy match if unset
FINDEPISODE_RATE_LIMIT_MAX=   # max /findepisode uses per user per 10 min (default: 5)
DB_PATH=                      # SQLite file path; default data/ubot.db relative to cwd (/app/data/ubot.db on the container volume)
KUMA_PUSH_URL=                # Uptime Kuma push monitor URL (no query string) — heartbeat every 60s
FEATURE_REQUEST_CHANNEL_ID=    # channel ID where /featurerequest posts land; unset = submissions fail gracefully
FEATURE_REQUEST_MAINTAINER_ID=  # user ID mentioned on each /featurerequest post (optional)
