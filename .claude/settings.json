{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(node *)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git rev-parse*)",
      "Bash(git hash-object*)",
      "Bash(npx tsc*)",
      "Bash(gh issue*)",
      "Bash(gh pr*)",
      "Bash(gh label*)",
      "Bash(gh repo*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; echo \"$f\" | grep -q 'bot\\.js$' && node --check \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Checking bot.js syntax..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; echo \"$f\" | grep -qE '\\.js$' && node ./node_modules/.bin/mocha; } 2>/dev/null || true",
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  }
}
